
WITH

cte_f_actual  AS
    (
        Select 
            'f_actual' AS tabl_name,
            fy_cd,
            pd_no,
            rate_type,
            sum(gross_revenue)   AS gross_revenue, 
            sum(direct_cost)  AS direct_cost, 
            sum(indirect_cost)  AS indirect_cost, 
            sum(fully_burdened_cost)  AS fully_burdened_cost, 
            sum(operating_income)  AS operating_income,
            sum(mgmt_proj_cost)  AS mgmt_proj_cost,
            sum(mgmt_operating_income_grossup)  AS mgmt_operating_income_grossup,
            sum(mgmt_operating_income) AS mgmt_operating_income
        From silver_finance.f_actual a
        where proj_id not in  ('ASM', 'IC Eliminations')
        Group By 
            fy_cd,
            pd_no,
            rate_type
    ),

cte_f_pl  AS
    (
        Select 
            'f_pl' AS tabl_name,
            fy_cd,
            pd_no,
            rate_type,
            sum(gross_revenue)   AS gross_revenue, 
            sum(direct_cost)  AS direct_cost, 
            sum(indirect_cost)  AS indirect_cost, 
            sum(fully_burdened_cost)  AS fully_burdened_cost, 
            sum(operating_income)  AS operating_income,
            sum(mgmt_proj_cost)  AS mgmt_proj_cost,
            sum(mgmt_operating_income_grossup)  AS mgmt_operating_income_grossup,
            sum(mgmt_operating_income) AS mgmt_operating_income
        From gold_finance.f_pl
        where  version_id = 'Actuals' and proj_id not in  ('ASM', 'IC Eliminations')
        Group By 
            fy_cd,
            pd_no,
            rate_type
    ),

cte_f_pl_sg  AS
    (
        Select 
            'f_pl_sg' AS tabl_name,
            fy_cd,
            pd_no,
            rate_type,
            sum(gross_revenue)   AS gross_revenue, 
            sum(direct_cost)  AS direct_cost, 
            sum(indirect_cost)  AS indirect_cost, 
            sum(fully_burdened_cost)  AS fully_burdened_cost, 
            sum(operating_income)  AS operating_income,
            sum(mgmt_proj_cost)  AS mgmt_proj_cost,
            sum(mgmt_operating_income_grossup)  AS mgmt_operating_income_grossup,
            sum(mgmt_operating_income) AS mgmt_operating_income
        From gold_finance.f_pl_sg
        where  version_id = 'Actuals' and proj_id not in  ('ASM', 'IC Eliminations')
        Group By 
            fy_cd,
            pd_no,
            rate_type
    ),

cte_f_pl_fs_indrct_act  AS
    (
        Select 
            'f_pl_fs_indrct' AS tabl_name,
            fy_cd,
            pd_no,
            'Actual' as rate_type,
            sum(case when fs_major_desc = 'Gross Revenue' then amount_act * -1 else 0 end) as gross_revenue, 
            sum(case when fs_major_desc = 'Total Direct Cost' then amount_act else 0 end) direct_cost, 
            sum(case when fs_major_desc = 'Total Indirect Cost' then amount_act else 0 end) AS indirect_cost, 
            sum(case when fs_major_desc in ('Total Indirect Cost', 'Total Direct Cost') then amount_act else 0 end) AS fully_burdened_cost, 
            sum(case when fs_major_desc <> 'Sales' then amount_act else 0 end)*-1  AS operating_income,
            sum(mgmt_proj_cost)  AS mgmt_proj_cost,
            sum(mgmt_operating_income_grossup)  AS mgmt_operating_income_grossup,
            sum(mgmt_operating_income) AS mgmt_operating_income
        From gold_finance.f_pl_fs_indrct
        where  proj_id not in  ('ASM', 'IC Eliminations')
        Group By 
            fy_cd,
            pd_no
    ),

cte_f_pl_fs_indrct_tgt  AS
    (
        Select 
            'f_pl_fs_indrct' AS tabl_name,
            fy_cd,
            pd_no,
            'Target' as rate_type,
            sum(case when fs_major_desc = 'Gross Revenue' then amount_tgt * -1 else 0 end) as gross_revenue, 
            sum(case when fs_major_desc = 'Total Direct Cost' then amount_tgt else 0 end) direct_cost, 
            sum(case when fs_major_desc = 'Total Indirect Cost' then amount_tgt else 0 end) AS indirect_cost, 
            sum(case when fs_major_desc in ('Total Indirect Cost', 'Total Direct Cost') then amount_tgt else 0 end) AS fully_burdened_cost, 
            sum(case when fs_major_desc <> 'Sales' then amount_tgt else 0 end)*-1  AS operating_income,
            sum(mgmt_proj_cost)  AS mgmt_proj_cost,
            sum(mgmt_operating_income_grossup)  AS mgmt_operating_income_grossup,
            sum(mgmt_operating_income) AS mgmt_operating_income
        From gold_finance.f_pl_fs_indrct
        where proj_id not in  ('ASM', 'IC Eliminations')
        Group By 
            fy_cd,
            pd_no
    ),

cte_f_pl_fs_indrct_sg_act  AS
    (
        Select 
            'f_pl_fs_indrct_sg' AS tabl_name,
            fy_cd,
            pd_no,
            'Actual' as rate_type,
            sum(case when fs_major_desc = 'Gross Revenue' then amount_act * -1 else 0 end) as gross_revenue, 
            sum(case when fs_major_desc = 'Total Direct Cost' then amount_act else 0 end) direct_cost, 
            sum(case when fs_major_desc = 'Total Indirect Cost' then amount_act else 0 end) AS indirect_cost, 
            sum(case when fs_major_desc in ('Total Indirect Cost', 'Total Direct Cost') then amount_act else 0 end) AS fully_burdened_cost, 
            sum(case when fs_major_desc <> 'Sales' then amount_act else 0 end)*-1  AS operating_income,
            sum(mgmt_proj_cost)  AS mgmt_proj_cost,
            sum(mgmt_operating_income_grossup)  AS mgmt_operating_income_grossup,
            sum(mgmt_operating_income) AS mgmt_operating_income
        From gold_finance.f_pl_fs_indrct_sg
        where  proj_id not in  ('ASM', 'IC Eliminations')
        Group By 
            fy_cd,
            pd_no
    ),

cte_f_pl_fs_indrct_sg_tgt  AS
    (
        Select 
            'f_pl_fs_indrct_sg' AS tabl_name,
            fy_cd,
            pd_no,
            'Target' as rate_type,
            sum(case when fs_major_desc = 'Gross Revenue' then amount_tgt * -1 else 0 end) as gross_revenue, 
            sum(case when fs_major_desc = 'Total Direct Cost' then amount_tgt else 0 end) direct_cost, 
            sum(case when fs_major_desc = 'Total Indirect Cost' then amount_tgt else 0 end) AS indirect_cost, 
            sum(case when fs_major_desc in ('Total Indirect Cost', 'Total Direct Cost') then amount_tgt else 0 end) AS fully_burdened_cost, 
            sum(case when fs_major_desc <> 'Sales' then amount_tgt else 0 end)*-1  AS operating_income,
            sum(mgmt_proj_cost)  AS mgmt_proj_cost,
            sum(mgmt_operating_income_grossup)  AS mgmt_operating_income_grossup,
            sum(mgmt_operating_income) AS mgmt_operating_income
        From gold_finance.f_pl_fs_indrct_sg
        where proj_id not in  ('ASM', 'IC Eliminations')
        Group By 
            fy_cd,
            pd_no
    )

SELECT * FROM 
    (
        SELECT * FROM cte_f_actual 
    UNION ALL
        SELECT * FROM cte_f_pl
    UNION ALL
        SELECT * from cte_f_pl_sg
    UNION ALL
        SELECT * from cte_f_pl_fs_indrct_act
    UNION ALL
        SELECT * from cte_f_pl_fs_indrct_tgt
    UNION ALL
        SELECT * from cte_f_pl_fs_indrct_sg_act
    UNION ALL
        SELECT * from cte_f_pl_fs_indrct_sg_tgt

    )

where fy_cd = 2026
and pd_no = 11
ORDER BY rate_type, tabl_name
