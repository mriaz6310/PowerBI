WITH cte_f_actual AS (
    SELECT
        'f_actual' AS tabl_name,
        fy_cd, pd_no, rate_type,
        sum(indirect_cost) AS indirect_cost
    FROM silver_finance.f_actual
    WHERE proj_id NOT IN ('ASM', 'IC Eliminations')
      AND fy_cd = 2026 AND pd_no = 11
    GROUP BY fy_cd, pd_no, rate_type
),

cte_f_pl AS (
    SELECT
        'f_pl' AS tabl_name,
        fy_cd, pd_no, rate_type,
        sum(indirect_cost) AS indirect_cost
    FROM gold_finance.f_pl
    WHERE version_id = 'Actuals'
      AND proj_id NOT IN ('ASM', 'IC Eliminations')
      AND fy_cd = 2026 AND pd_no = 11
    GROUP BY fy_cd, pd_no, rate_type
),

cte_f_pl_sg AS (
    SELECT
        'f_pl_sg' AS tabl_name,
        fy_cd, pd_no, rate_type,
        sum(indirect_cost) AS indirect_cost
    FROM gold_finance.f_pl_sg
    WHERE version_id = 'Actuals'
      AND proj_id NOT IN ('ASM', 'IC Eliminations')
      AND fy_cd = 2026 AND pd_no = 11
    GROUP BY fy_cd, pd_no, rate_type
),

cte_f_pl_fs_indrct_act AS (
    SELECT
        'f_pl_fs_indrct' AS tabl_name,
        fy_cd, pd_no, 'Actual' AS rate_type,
        sum(CASE WHEN fs_major_desc = 'Total Indirect Cost' THEN amount_act ELSE 0 END) AS indirect_cost
    FROM gold_finance.f_pl_fs_indrct
    WHERE proj_id NOT IN ('ASM', 'IC Eliminations')
      AND fy_cd = 2026 AND pd_no = 11
    GROUP BY fy_cd, pd_no
),

cte_f_pl_fs_indrct_tgt AS (
    SELECT
        'f_pl_fs_indrct' AS tabl_name,
        fy_cd, pd_no, 'Target' AS rate_type,
        sum(CASE WHEN fs_major_desc = 'Total Indirect Cost' THEN amount_tgt ELSE 0 END) AS indirect_cost
    FROM gold_finance.f_pl_fs_indrct
    WHERE proj_id NOT IN ('ASM', 'IC Eliminations')
      AND fy_cd = 2026 AND pd_no = 11
    GROUP BY fy_cd, pd_no
),

cte_f_pl_fs_indrct_sg_act AS (
    SELECT
        'f_pl_fs_indrct_sg' AS tabl_name,
        fy_cd, pd_no, 'Actual' AS rate_type,
        sum(CASE WHEN fs_major_desc = 'Total Indirect Cost' THEN amount_act ELSE 0 END) AS indirect_cost
    FROM gold_finance.f_pl_fs_indrct_sg
    WHERE proj_id NOT IN ('ASM', 'IC Eliminations')
      AND fy_cd = 2026 AND pd_no = 11
    GROUP BY fy_cd, pd_no
),

cte_f_pl_fs_indrct_sg_tgt AS (
    SELECT
        'f_pl_fs_indrct_sg' AS tabl_name,
        fy_cd, pd_no, 'Target' AS rate_type,
        sum(CASE WHEN fs_major_desc = 'Total Indirect Cost' THEN amount_tgt ELSE 0 END) AS indirect_cost
    FROM gold_finance.f_pl_fs_indrct_sg
    WHERE proj_id NOT IN ('ASM', 'IC Eliminations')
      AND fy_cd = 2026 AND pd_no = 11
    GROUP BY fy_cd, pd_no
),

combined AS (
    SELECT * FROM cte_f_actual
    UNION ALL SELECT * FROM cte_f_pl
    UNION ALL SELECT * FROM cte_f_pl_sg
    UNION ALL SELECT * FROM cte_f_pl_fs_indrct_act
    UNION ALL SELECT * FROM cte_f_pl_fs_indrct_tgt
    UNION ALL SELECT * FROM cte_f_pl_fs_indrct_sg_act
    UNION ALL SELECT * FROM cte_f_pl_fs_indrct_sg_tgt
)

SELECT
    rate_type,
    MAX(CASE WHEN tabl_name = 'f_actual' THEN indirect_cost END)          AS f_actual,
    MAX(CASE WHEN tabl_name = 'f_pl' THEN indirect_cost END)              AS f_pl,
    MAX(CASE WHEN tabl_name = 'f_pl_sg' THEN indirect_cost END)           AS f_pl_sg,
    MAX(CASE WHEN tabl_name = 'f_pl_fs_indrct' THEN indirect_cost END)    AS f_pl_fs_indrct,
    MAX(CASE WHEN tabl_name = 'f_pl_fs_indrct_sg' THEN indirect_cost END) AS f_pl_fs_indrct_sg
FROM combined
GROUP BY rate_type
ORDER BY rate_type;
