%sql
-- ============================================================================  
-- SCRIPT: Add and populate ACT management columns in f_pl_fs_indrct  
-- ============================================================================  
-- This script:  
-- 1. Alters gold_finance.f_pl_fs_indrct to add 5 management columns  
-- 2. Populates them using margin_percent lookup logic  
-- 3. Looks up margin_percent by joining:  
--    f_pl_fs_indrct → ref_iwo_product_lookup (on proj_id) 
--                   → ref_product_margin_rates (on product_cd AND fy_cd)  
-- ============================================================================


-- ----------------------------------------------------------------------------  
-- STEP 1: Add new columns to the gold_finance.f_pl_fs_indrct table  
-- ----------------------------------------------------------------------------  

ALTER TABLE gold_finance.f_pl_fs_indrct 
ADD COLUMNS (  
    fully_burdened_cost DECIMAL(18,4),  
    operating_income DECIMAL(18,4),  
    mgmt_proj_cost DECIMAL(18,4),  
    mgmt_operating_income_grossup DECIMAL(18,4),  
    mgmt_operating_income DECIMAL(18,4)  
);


-- ----------------------------------------------------------------------------  
-- STEP 2: Update f_pl_fs_indrct with calculated values using margin_percent lookup  
-- ----------------------------------------------------------------------------  
-- Join path: f_pl_fs_indrct → ref_iwo_product_lookup → ref_product_margin_rates  
-- Deduplication: ROW_NUMBER ensures one margin_percent per (proj_id, fy_cd)  
-- 
-- Business Logic:  
-- - fully_burdened_cost: Set to amount_act (total cost for this line)  
-- - operating_income: Set to amount_act (income/cost for this line)  
-- - mgmt_proj_cost: amount_act only when acct_id = '580-040-011', else 0  
-- - mgmt_operating_income_grossup: mgmt_proj_cost × margin_percent  
-- - mgmt_operating_income: operating_income + grossup  
-- ----------------------------------------------------------------------------

MERGE INTO gold_finance.f_pl_fs_indrct AS target  
USING (  
    SELECT 
        proj_id,  
        fy_cd,  
        margin_percent  
    FROM (  
        SELECT 
            f.proj_id,  
            f.fy_cd,  
            m.margin_percent,  
            ROW_NUMBER() OVER(  
                PARTITION BY f.proj_id, f.fy_cd 
                ORDER BY ref.product_cd, m.margin_percent DESC  
            ) AS rn  
        FROM (  
            SELECT DISTINCT proj_id, fy_cd 
            FROM gold_finance.f_pl_fs_indrct  
        ) f  
        -- Join 1: Get product_cd from ref_iwo_product_lookup  
        INNER JOIN silver_finance.ref_iwo_product_lookup ref 
            ON f.proj_id = ref.proj_id  
        -- Join 2: Get margin_percent from ref_product_margin_rates  
        INNER JOIN silver_tm1.ref_product_margin_rates m 
            ON ref.product_cd = m.product_cd 
            AND f.fy_cd = m.fy_cd  
    )  
    WHERE rn = 1  -- Deduplicate: one row per (proj_id, fy_cd)  
) AS source  
ON target.proj_id = source.proj_id 
   AND target.fy_cd = source.fy_cd  
WHEN MATCHED THEN  
  UPDATE SET  
    -- Column 1: Fully Burdened Cost (use amount_act as the cost basis)  
    target.fully_burdened_cost = target.amount_act,  
    
    -- Column 2: Operating Income (use amount_act as the income basis)  
    target.operating_income = target.amount_act,  
    
    -- Column 3: Management Project Cost (only for acct_id = '580-040-011')  
    target.mgmt_proj_cost = CASE 
        WHEN target.acct_id = '580-040-011' THEN target.amount_act 
        ELSE 0 
    END,  
    
    -- Column 4: Management Operating Income Grossup (mgmt_proj_cost × margin_percent)  
    target.mgmt_operating_income_grossup = 
        (CASE WHEN target.acct_id = '580-040-011' THEN target.amount_act ELSE 0 END) 
        * COALESCE(source.margin_percent, 0),  
    
    -- Column 5: Management Operating Income (operating_income + grossup)  
    target.mgmt_operating_income = 
        target.amount_act 
        + ((CASE WHEN target.acct_id = '580-040-011' THEN target.amount_act ELSE 0 END) 
           * COALESCE(source.margin_percent, 0));


-- ----------------------------------------------------------------------------  
-- STEP 3: Update records WITHOUT matching products (margin_percent = 0)  
-- ----------------------------------------------------------------------------  
-- For projects that don't exist in the lookup tables, set margin-related 
-- fields to 0  
-- ----------------------------------------------------------------------------

UPDATE gold_finance.f_pl_fs_indrct  
SET 
    fully_burdened_cost = amount_act,  
    operating_income = amount_act,  
    mgmt_proj_cost = CASE WHEN acct_id = '580-040-011' THEN amount_act ELSE 0 END,  
    mgmt_operating_income_grossup = 0,  
    mgmt_operating_income = amount_act  
WHERE NOT EXISTS (  
    SELECT 1  
    FROM silver_finance.ref_iwo_product_lookup ref  
    INNER JOIN silver_tm1.ref_product_margin_rates m 
        ON ref.product_cd = m.product_cd 
        AND f_pl_fs_indrct.fy_cd = m.fy_cd  
    WHERE f_pl_fs_indrct.proj_id = ref.proj_id  
);





